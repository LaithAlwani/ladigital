{
  "name": "ladigital-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "create-client": "node scripts/create-client.mjs",
    "ladigital": "npm run dev -w la-digital",
    "build:ladigital": "npm run build -w la-digital",
    "convex": "npm exec -w la-digital -- convex",
    "convex:dev": "npm exec -w la-digital -- convex dev",
    "convex:deploy": "npm exec -w la-digital -- convex deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
